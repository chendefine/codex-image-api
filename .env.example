# Copy to .env and adjust: cp .env.example .env

# ---------- build-time ----------
# Go toolchain image tag for the builder stage (golang:<GO_VERSION>-alpine); must satisfy go.mod.
GO_VERSION=1.27
# Go module proxy, e.g. https://goproxy.cn,direct in mainland China.
GOPROXY=https://proxy.golang.org,direct
# Base image of the runner stage.
RUNTIME_IMAGE=debian:13-slim
# codex CLI version installed in the image (GitHub release tag without "rust-v").
CODEX_VERSION=0.162.0
# Mirror of https://github.com/openai/codex/releases/download if GitHub is slow.
CODEX_DOWNLOAD_BASE=https://github.com/openai/codex/releases/download
# Name of the built image.
IMAGE=codex-image-api:latest

# ---------- build + runtime ----------
# uid/gid the service (and codex) runs as. MUST equal the owner of CODEX_AUTH_FILE
# (auth.json is mode 0600). Get them with: stat -c '%u %g' ~/.codex/auth.json   (or: id -u; id -g)
APP_UID=1000
APP_GID=1000

# ---------- runtime ----------
# auth.json of a host codex logged in with ChatGPT (`codex login`). Only this file
# is shared; the rest of CODEX_HOME is CODEX_HOME_DIR. It is mounted
# read-write because codex rotates the refresh token and both sides must see it.
CODEX_AUTH_FILE=/home/develop/.codex/auth.json
# Host directory used as the container's CODEX_HOME (sessions, generated_images,
# skills, caches; codex fills it on first run). Must exist and be owned by
# APP_UID:APP_GID before `docker compose up`: mkdir -p codex-home
CODEX_HOME_DIR=./codex-home
# Host directory for per-request working directories (must be writable by APP_UID).
WORKSPACE_DIR=./workspace
# Service config mounted into the container. In it use workspace.dir: /data/workspace
# and codex.sandbox: danger-full-access (see README "Docker").
CONFIG_FILE=./config.yaml
# Host address/port to publish the API on. Use 0.0.0.0 to expose on all interfaces.
HOST_BIND=127.0.0.1
HOST_PORT=8080
# MTU of the compose network. Lower it (e.g. 1480/1420) if the host's path MTU is
# below 1500 (check: ip route get 1.1.1.1 | grep mtu); a too-large MTU makes codex
# hang on "workspace routing discovery failed" / connection errors.
NETWORK_MTU=1500
# Optional outbound proxy for codex (chatgpt.com). Use host.docker.internal for
# a proxy running on the Docker host; it must listen on an address reachable
# from the container (not only 127.0.0.1).
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
